GEMINI_API_KEY=your_gemini_api_key_here

# From the Meta App dashboard (developers.facebook.com/apps -> your app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=your_whatsapp_access_token_here
PHONE_NUMBER_ID=your_phone_number_id_here

# App secret (App dashboard -> App Settings -> Basic -> App Secret). Used to
# verify that incoming webhook POSTs actually came from Meta.
META_APP_SECRET=your_app_secret_here

# You invent this string yourself - any random value you pick. You enter the
# SAME value in the Meta dashboard's webhook setup screen. It only proves you
# control this endpoint during the one-time verification handshake.
META_VERIFY_TOKEN=choose_any_random_string_here

# PostgreSQL. Without it, conversations and learned facts are lost on every
# restart - which on Render's free tier means every time the service wakes from
# sleep. Render Postgres "Internal Database URL" goes here.
DATABASE_URL=postgresql://user:password@host/dbname

# Google Calendar. The full service-account JSON key, as a single line.
# The service account has its own empty "primary" calendar, so the target
# calendar must be named explicitly - it is the Google address of the calendar
# that was SHARED with the service account (share it with "Make changes to
# events" from calendar.google.com).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_CALENDAR_ID=the_calendar_owner_address@gmail.com

# Gmail. Unlike Calendar there is no service-account path for a personal
# @gmail.com account, so this needs a one-time browser approval. See
# scripts/get_gmail_refresh_token.py. The token grants gmail.readonly,
# gmail.compose and drive - the assistant can draft but is incapable of
# sending, and can read Drive but never delete or share; both limits live in
# gmail_tools.py and drive_tools.py, not in the scopes.
GMAIL_CLIENT_ID=your_oauth_client_id_here
GMAIL_CLIENT_SECRET=your_oauth_client_secret_here
GMAIL_REFRESH_TOKEN=your_refresh_token_here

# Google Drive. The ONE folder the assistant may create and edit files in -
# everything else in the Drive is readable and not writable. Take the id from
# the folder's URL: drive.google.com/drive/folders/<this part>. Left unset,
# every write is refused; unset means "nowhere", not "anywhere".
DRIVE_FOLDER_ID=the_folder_id_from_the_drive_url

# Optional. Overrides the Gemini model without a code change - model names
# go stale without warning (gemini-1.5-flash and gemini-2.5-flash both
# stopped working during this project's own development). Defaults to
# gemini-3.6-flash if unset.
# GEMINI_MODEL_NAME=gemini-3.6-flash

# Optional. Graph API version, in case Meta deprecates the pinned default.
# GRAPH_API_VERSION=v21.0

# אופציונלי - מודל נפרד לכלי האינטרנט. ברירת המחדל עוקבת אחרי GEMINI_MODEL_NAME.
# GEMINI_WEB_MODEL_NAME=gemini-3.6-flash

# חיפוש חי באינטרנט. בלי המפתח הזה הכלי search_web עונה שהוא לא מוגדר במקום
# לנחש - הדרך של Gemini (google_search) דורשת תוכנית בתשלום. Tavily נותנת
# 1,000 חיפושים בחודש בחינם, בלי כרטיס אשראי: app.tavily.com -> Sign up ->
# העתקת המפתח מ-API Keys. המפתח מתחיל ב-tvly-.
# TAVILY_API_KEY=tvly-your_key_here

# --- הלב הפועם: השעון שהופך את העוזר מפאסיבי לאקטיבי ---

# סוד שמגן על /tick. בלי המשתנה הזה הנתיב לא קיים בכלל (404) - זו ברירת
# המחדל הבטוחה: שירות בלי שעון שותק, ולא נותן לכל אחד באינטרנט להפעיל
# הודעות יזומות. מי שקורא ל-/tick שולח אותו בכותרת X-Tick-Secret או
# בפרמטר ?key=. ליצירת ערך אקראי: אפשר כל מחרוזת ארוכה ואקראית.
# TICK_SECRET=a_long_random_string

# מספר הוואטסאפ של איתי, בפורמט בינלאומי בלי + (למשל 9725...). ההודעות
# היזומות נשלחות לשם. אם לא מוגדר, המערכת שולחת למי שכתב אחרון - עובד,
# אבל שביר: כל מי שיכתוב לבוט יקבל את התזכורות.
# OWNER_PHONE=9725xxxxxxxx

# --- מפל המודלים (llm.py) ---------------------------------------------
# Gemini החינמי נותן 20 בקשות ליום, וזו תקרה אמיתית שכבר נסגרה בפרודקשן.
# שני המפתחות הבאים אופציונליים - בלעדיהם הכל עובד כמו קודם, ורק התקרה
# נשארת 20. עם GROQ_API_KEY היא הופכת ל-1,020 בקשות ביום, בחינם, בלי כרטיס
# אשראי (console.groq.com). OPENROUTER_API_KEY מוסיף עוד 50 (openrouter.ai).
GROQ_API_KEY=
OPENROUTER_API_KEY=
# שמות מודלים - רק אם רוצים לחרוג מברירת המחדל שבתוך llm.py
# GROQ_MODEL_NAME=llama-3.3-70b-versatile
# OPENROUTER_MODEL_NAME=meta-llama/llama-3.3-70b-instruct:free
